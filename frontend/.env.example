# Local SQLite database (dev only). Never commit a real .env.
DATABASE_URL="file:./db/custom.db"

# Optional: base URL of the SkillCrash FastAPI backend.
#
# Unset (or not an http(s) URL) = demo mode:
#   - the browser demo adapter simulates attack generation locally
#   - nothing is sent to a model and no backend request is made
#   - the UI labels output as "demo adapter" / "simulated"
#
# Set it to enable the HTTP adapter, which probes `<url>/health` and posts
# attack generation to `<url>/attacks/generate`. The workspace header shows
# "Live API" only when that probe succeeds AND the backend reports live mode.
#
# Local development:
# NEXT_PUBLIC_SKILLCRASH_API="http://127.0.0.1:8000"
#
# Deployed (Vercel): set this in the dashboard, scoped to Production, then
# redeploy. NEXT_PUBLIC_* values are inlined at build time. Use the public
# https:// backend URL, never localhost and never http://.
