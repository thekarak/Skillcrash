# Local SQLite database (dev only). Never commit a real .env.
DATABASE_URL="file:./db/custom.db"

# Optional: base URL of the SkillCrash FastAPI backend.
#
# Unset (or not an http(s) URL) = demo mode:
#   - the browser demo adapter simulates attack generation locally
#   - nothing is sent to a model and no backend request is made
#   - the UI labels output as "demo adapter" / "simulated"
#
# Set it to enable the HTTP adapter, which probes `<url>/health` and posts
# attack generation to `<url>/attacks/generate`. The workspace header only
# shows "live" after that health probe succeeds.
#
# NEXT_PUBLIC_SKILLCRASH_API="http://localhost:8000"
