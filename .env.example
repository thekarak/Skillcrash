# Google AI Studio API Key
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemma 4 Model Selection
# Default: gemma-4-31b-it (Recommended). Alternative: gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it

# Set to 1 to enable live Gemma 4 model inference across Attack Generation, Agent Simulation, and Fix Suggestion
SKILLCRASH_USE_GEMMA=1

# Comma-separated Google models tried if the primary model is unavailable.
# GEMMA_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# Extra CORS origins for deployed frontends (comma-separated).
# CORS_ORIGINS=https://your-frontend.example.com
